    version: f173ea285cce7bbbfc1dbc382e31c761f44b0963

  px4_autopilot:
    type: git
    url: https://github.com/PX4/PX4-Autopilot.git
    version: d6f12ad1c4f70ad3230afd7d86e971421e02fef4

