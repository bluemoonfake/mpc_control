{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MPC validation evidence manifest",
  "type": "object",
  "required": [
    "run_id",
    "environment",
    "source_revision",
    "mission_sha256",
    "parameters_sha256",
    "started_at_utc",
    "result"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "environment": {"enum": ["sitl", "hitl", "real"]},
    "source_revision": {"type": "string", "minLength": 1},
    "px4_revision": {"type": "string"},
    "mission_sha256": {"type": "string", "minLength": 64},
    "parameters_sha256": {"type": "string", "minLength": 64},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "result": {"enum": ["PASS", "FAIL", "ABORTED"]}
  },
  "additionalProperties": true
}
